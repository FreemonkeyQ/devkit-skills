{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devkit project adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gates"],
  "properties": {
    "version": {"const": 1},
    "root": {"type": "string"},
    "language": {"type": "string"},
    "rulesFiles": {"type": "array", "items": {"type": "string"}},
    "scopeHints": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "commands": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "required", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "kind": {"enum": ["test", "lint", "build", "docs", "i18n", "manual", "release", "custom"]},
          "command": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "timeout": {"type": "integer", "minimum": 1, "default": 600}
        }
      }
    }
  }
}

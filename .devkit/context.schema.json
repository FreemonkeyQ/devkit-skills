{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devkit run context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "goal", "scope_files", "reused", "decisions", "evidence"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"type": "string"},
    "goal": {"type": "string"},
    "scope_files": {"type": "array", "items": {"type": "string"}},
    "reused": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "kind", "detail"],
        "properties": {
          "skill": {"type": "string"},
          "kind": {"type": "string"},
          "detail": {"type": "string"},
          "at": {"type": "string"}
        }
      }
    },
    "updatedAt": {"type": "string"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devkit configuration v1",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specs": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "adr": {
          "type": "string",
          "minLength": 1
        },
        "research": {
          "type": "string",
          "minLength": 1
        },
        "reviews": {
          "type": "string",
          "minLength": 1
        },
        "audits": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "local",
            "gitlab",
            "github"
          ]
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devUrl": {
          "type": "string"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchPrefix": {
          "type": "string"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "auto",
            "gitlab",
            "github",
            "none"
          ]
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        }
      }
    }
  }
}

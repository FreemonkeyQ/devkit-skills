{
  "version": 1,
  "language": "zh-CN",
  "paths": {
    "specs": ".devkit/specs",
    "issues": ".devkit/issues",
    "status": ".devkit/STATUS.md",
    "state": ".devkit/state.json",
    "changes": "docs/changes",
    "index": "docs/INDEX.md"
  },
  "docs": {
    "profile": "light"
  },
  "tracker": {
    "kind": "local"
  },
  "commands": {},
  "frontend": {
    "devUrl": ""
  },
  "git": {
    "branchPrefix": "feat/"
  },
  "ci": {
    "provider": "auto",
    "waitSeconds": 600,
    "pollSeconds": 30
  }
}
